# =============================================================================
# SabaikoPasal frontend configuration (example)
#
# Copy this file to `efont/.env` and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# =============================================================================

# Backend API base URL (no trailing slash). Axios appends `/api` automatically.
VITE_BACK_END_URL=http://localhost:8080

# Frontend URL (used for Stripe `return_url` and similar callbacks).
VITE_FRONTEND_URL=http://localhost:5173

# eSewa payment gateway URL.
# Defaults to the sandbox if omitted. For production switch to:
#   https://epay.esewa.com.np/api/epay/main/v2/form
VITE_ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Stripe publishable key (only required for the in-progress Stripe flow).
# Get one at https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
