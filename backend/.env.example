# =============================================================================
# SabaikoPasal backend configuration (example)
#
# Copy this file to `.env` and fill in real values, OR translate the keys into
# `backend/src/main/resources/application.properties` (which is gitignored).
#
# Spring Boot relaxed binding maps these env vars onto property keys, e.g.
#   SPRING_DATASOURCE_URL  ->  spring.datasource.url
#   SPRING_APP_JWTSECRET   ->  spring.app.jwtSecret
# =============================================================================

# --- Server -------------------------------------------------------------------
SERVER_PORT=8080

# --- Frontend (used in CORS and eSewa redirect URLs) --------------------------
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sb_ecom
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_me

# --- JPA / Hibernate ----------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# --- JWT ----------------------------------------------------------------------
# 64+ char base64 secret. Generate with:  openssl rand -base64 64
SPRING_APP_JWTSECRET=replace_with_a_long_random_base64_secret
SPRING_APP_JWTEXPIRATIONMS=86400000
SPRING_APP_JWTCOOKIENAME=springBootEcom

# --- Image upload -------------------------------------------------------------
# Local directory where product / promotion images are stored.
# Must end with a trailing slash and be writable by the JVM process.
PROJECT_IMAGE=images/

# --- Mail (used for password reset emails) ------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_smtp_username
SPRING_MAIL_PASSWORD=your_smtp_password_or_app_password
SPRING_MAIL_FROM=no-reply@sabaikopasal.local
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# --- eSewa (sandbox defaults shown; replace with real merchant values for prod)
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
